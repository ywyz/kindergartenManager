# 幼儿园教学管理系统 — 环境变量配置模板
# 将本文件复制为 .env 并填写必要字段后运行应用。
#
# 源码/桌面 SQLite：DATABASE_URL 留空即可；ENCRYPTION_KEY / JWT_SECRET 留空时
# 会自动生成并持久化到应用数据目录的 .kindergarten_secrets。
# Docker Compose：复制为 .env 后，必须先填写公网域名及下列两个 MySQL 密码；
# CADDY_DOMAIN 需已通过 DNS 解析到部署主机，Caddy 才会自动签发 HTTPS 证书。
# 为避免连接 URL 歧义，请使用密码管理器生成只含十六进制字符的长随机值，并让
# 普通用户密码与 compose 传入应用的值保持一致。

CADDY_DOMAIN=
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
MYSQL_USER=kindergarten
MYSQL_DATABASE=kindergarten_db

# ── 数据库 ───────────────────────────────────────────────────────────────────
# 留空 → 内嵌 SQLite（数据存于应用数据目录的 kindergarten.db）
# MySQL 示例：mysql+aiomysql://user:password@localhost:3306/kindergarten_db
DATABASE_URL=

# ── 密钥（生产/服务器环境强烈建议显式配置） ──────────────────────────────────
# 留空时程序自动生成并保存到 .kindergarten_secrets
# 生产环境请固化此值，否则重装/重启后已加密数据将无法解密
ENCRYPTION_KEY=
JWT_SECRET=
JWT_EXPIRE_MINUTES=60

# ── 节假日 API ────────────────────────────────────────────────────────────────
HOLIDAY_API_URL=https://timor.tech/api/holiday/info/
LOG_LEVEL=INFO

# ── 管理员初始化引导（可选，脚本方式初始化时使用） ───────────────────────────
# BOOTSTRAP_ADMIN_ENABLED=false
# BOOTSTRAP_ADMIN_TENANT_ID=1
# BOOTSTRAP_ADMIN_USERNAME=sysadmin
# BOOTSTRAP_ADMIN_PASSWORD=
# BOOTSTRAP_ADMIN_ALLOW_REMOTE=false

# ── 对外只读 REST API（二期，默认关闭） ─────────────────────────────────────
# 格式："apikey:tenant_id" 逗号分隔，例如 "svc-abc:1,svc-xyz:2"；留空则接口关闭
API_KEYS=
# HMAC-SHA256 签名共享密钥；非空时强制校验请求签名
API_SIGNING_SECRET=
API_SIGNATURE_MAX_SKEW=300
