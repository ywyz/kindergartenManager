# 环境与密钥
.env
.env.prod
.env.local
.kindergarten_secrets
.kindergarten_secrets.lock

# 本地 SQLite 数据（可能包含加密后的 AI Key 与用户资料）
*.db
*.sqlite
*.sqlite3
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm
*.db.*.bak
*.sqlite.*.bak
*.sqlite3.*.bak

# 虚拟环境
.venv/
.venv.bak*/
venv/
env/

# Python 缓存
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# NiceGUI 运行时存储（session 状态，不入仓）
.nicegui/

# 导出文件（不入仓）
exports/
!exports/.gitkeep

# IDE
.idea/
.vscode/settings.json
.vscode/*.code-snippets
*.swp
*.swo

# 测试覆盖率
.coverage
htmlcov/
.pytest_cache/

# 构建产物
dist/
build/
*.egg-info/

# 日志
*.log
