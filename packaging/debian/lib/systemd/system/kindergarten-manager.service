[Unit]
Description=幼儿园教学管理系统
Documentation=https://github.com/ywyz/kindergartenManager
After=network.target

[Service]
Type=simple
User=kindergarten-manager
Group=kindergarten-manager
WorkingDirectory=/var/lib/kindergarten-manager
EnvironmentFile=/etc/kindergarten-manager/env
ExecStart=/opt/kindergarten-manager/KindergartenManager
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=kindergarten-manager
UMask=0077

# 安全加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/kindergarten-manager

[Install]
WantedBy=multi-user.target
